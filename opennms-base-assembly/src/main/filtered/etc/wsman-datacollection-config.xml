<?xml version="1.0"?>
<wsman-datacollection-config rrdRepository="${install.share.dir}/rrd/snmp/">
    <wsman-collection name="default">
        <rrd step="30">
            <rra>RRA:AVERAGE:0.5:1:2016</rra>
            <rra>RRA:AVERAGE:0.5:12:1488</rra>
            <rra>RRA:AVERAGE:0.5:288:366</rra>
            <rra>RRA:MAX:0.5:288:366</rra>
            <rra>RRA:MIN:0.5:288:366</rra>
        </rrd>

        <wpms>
            <wpm name="dracPowerSupplyStats" wsmanNamespace="http://schemas.dell.com/wbem/wscim/1/cim-schema/2/DCIM_ComputerSystem/DCIM_PowerSupplyView"
                 ifType="all" resourceType="node">
                <attrib name="TotalOutputPower" alias="dracOutputPower" type="Gauge"/>
                <attrib name="InputVoltage" alias="dracInputVoltage" type="Gauge"/>
            </wpm>
        </wpms>
    </wsman-collection>
</wsman-datacollection-config>
